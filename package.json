{
  "name": "omega-script-studio",
  "version": "1.0.0",
  "description": "OMEGA Script Studio - Luau editor",
  "main": "src/main.js",
  "author": "OMEGA",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.omega.scriptstudio",
    "productName": "OMEGA Script Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
